// LifeSeed ART Bank — canonical Prisma schema
// Source: LifeSeed_App_Specs/data_model.md (with Decimal money + BANK_CFO / BANK_SITE_HEAD)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== FOUNDATIONAL =====

enum SiteCode {
  WB
  TG // Telangana
  BD // Bangladesh (future)
}

model Site {
  id        String   @id @default(cuid())
  code      SiteCode @unique
  name      String
  gstin     String?  @unique
  address   String
  panNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users      User[]
  donors     Donor[]
  clinics    Clinic[]
  samples    Sample[]
  drfs       DRF[]
  dispatches DispatchOrder[]
  challans   Challan[]
  invoices   Invoice[]
  qcGateConfigs       QcGateConfig[]
  categoryRuleConfigs CategoryRuleConfig[]
}

// ===== USERS + RBAC =====

enum UserRole {
  DONOR
  RECIPIENT
  CLINIC_DOCTOR
  CLINIC_COORDINATOR
  CLINIC_NURSE
  CLINIC_ADMIN
  CLINIC_EMBRYOLOGIST
  CLINIC_WITNESS
  BANK_DONOR_COORD
  BANK_ANDROLOGY_TECH
  BANK_SR_ANDROLOGIST
  BANK_LAB_HEAD
  BANK_WITNESS
  BANK_CRYOBANK_TECH
  BANK_QC_OFFICER
  BANK_MATCHING_OPS
  BANK_CLINICAL_REVIEWER
  BANK_FINANCE
  BANK_ACCOUNTS_MANAGER
  BANK_CFO
  BANK_SITE_HEAD
  BANK_COMPLIANCE
  BANK_DISPATCH_COORD
  BANK_LOGISTICS
  BANK_SITE_ADMIN
  BANK_MEDICAL_DIRECTOR
  BANK_BRM
  BANK_SUPER_ADMIN
  TELECALLER
  COUNSELLOR
  OPS_MANAGER
  MARKETING_MANAGER
  CRM_ADMIN
  L2_IVF_CLINICIAN
  L2_EMBRYOLOGIST
  L2_SR_EMBRYOLOGIST
  L2_LAB_HEAD
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String    @unique
  passwordHash String?
  isActive     Boolean   @default(true)
  mfaEnabled   Boolean   @default(false)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])

  roles     UserRoleAssignment[]
  auditLogs AuditLog[]

  chakraQuestionsCreated ChakraQuestion[] @relation("ChakraQuestionAuthor")
  rubricVersionsPublished RubricVersion[] @relation("RubricVersionPublisher")

  assignedLeads Lead[] @relation("LeadTelecaller")
  callDispositions CallDisposition[] @relation("CallDispositionTelecaller")
  counsellingSessions CounsellingBooking[] @relation("CounsellingCounsellor")
  dncEntries LeadDoNotCallList[] @relation("DncAddedBy")

  reportSchedulesCreated ReportSchedule[] @relation("ReportScheduleCreator")
  reportRuns             ReportRun[]      @relation("ReportRunActor")
  reportFavorites        ReportFavorite[]
  reportSnapshots        ReportSnapshot[] @relation("ReportSnapshotCapture")
  reportDeliveries       ReportDeliveryLog[]

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role      UserRole
  scopeType String? // 'site' | 'clinic' | 'global'
  scopeId   String?
  grantedAt DateTime @default(now())
  grantedBy String?

  @@unique([userId, role, scopeType, scopeId])
}

// ===== DONOR =====

enum DonorType {
  SEMEN
  OOCYTE
}

enum DonorStatus {
  PROSPECT
  ELIGIBLE
  ACTIVE
  DEFERRED
  REJECTED
  WITHDRAWN
  RETIRED
  SUSPENDED
}

/// Bank Admin journey phases (P0–P4) for donor pathway UI + guards.
enum DonorPhase {
  P0_INTAKE
  P1_SCREENING
  P2_ACTIVE
  P3_DRF
  P4_OUTCOME
}

/// Canonical rejection / deferral reason codes (common trunk + serology).
enum RejectionCode {
  REG_AGE
  REG_MAR
  REG_CHILD
  OPS_KYC
  OPS_DUP
  OPS_GEO
  WDR_VOL
  MED_INF
  MED_PHY
  GEN_HX
  SEROLOGY_POSITIVE
}

enum SampleType {
  REGULAR
  QUARANTINE
}

enum SamplePriority {
  REGULAR
  URGENT
}

model Donor {
  id        String    @id @default(cuid())
  donorCode String    @unique // D-{Site}-NNNNN
  type      DonorType
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id])

  fullName    String
  dob         DateTime
  gender      String
  aadhaarHash String?  @unique
  panMasked   String?
  phone       String
  email       String?
  addressLine String?
  city        String?
  stateCode   String?
  pincode     String?

  maritalStatus   String?
  hasLivingChild  Boolean?
  marriageCertUrl String?
  childCertUrl    String?

  status                 DonorStatus    @default(PROSPECT)
  phase                  DonorPhase     @default(P0_INTAKE)
  rejectionCode          RejectionCode?
  passportIssuedAt       DateTime?
  registryEntryId        String?
  cumulativePregnancies  Int            @default(0)
  bankPolicyCap          Int?
  deferredUntil          DateTime?
  outcomeNotes           String?

  bloodGroup String?
  rhFactor   String?
  height     Int?
  weight     Int?
  bmi        Float?

  consents  DonorConsent[]
  labTests  LabTest[]
  samples   Sample[]         @relation("SampleDonor")
  donations DonationRecord[]
  auditLogs AuditLog[]       @relation("AuditLogDonor")

  /// SeedScore (nullable — legacy donors remain UNSCORED)
  currentSeedScoreId  String?         @unique
  currentSeedScore    SeedScore?      @relation("DonorCurrentScoreRef", fields: [currentSeedScoreId], references: [id])
  seedScore           SeedScore?      @relation("SeedScoreOwner")
  seedScoreHistory    SeedScoreHistory[]
  currentTier         SeedScoreTier?  @default(UNSCORED)
  firstScoredAt       DateTime?
  lastScoredAt        DateTime?
  scoreRecalcRequired Boolean         @default(false)

  /// Upstream Lead Management link (nullable — pre-Lead donors stay null)
  sourceLeadId String? @unique
  sourceLead   Lead?   @relation("LeadConvertedDonor", fields: [sourceLeadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([phase])
  @@index([currentTier])
}

model DonorConsent {
  id          String    @id @default(cuid())
  donorId     String
  donor       Donor     @relation(fields: [donorId], references: [id])
  consentType String
  version     String
  contentHash String
  signedAt    DateTime
  signedIp    String?
  videoUrl    String?
  witnesses   String[]
  revokedAt   DateTime?
}

model LabTest {
  id                String    @id @default(cuid())
  donorId           String
  donor             Donor     @relation(fields: [donorId], references: [id])
  testCode          String
  requisitionSource String
  requisitionedBy   String?
  result            String?
  resultValue       Float?
  unit              String?
  reportUrl         String?
  performedAt       DateTime?
  createdAt         DateTime  @default(now())
}

// ===== SAMPLE + VIAL (Andrology) =====

/// Grade tier (A/B/C) — QC-A5 post-thaw metrics. Alias: GradeTier.
enum SampleGrade {
  A
  B
  C
  REJECTED
}

/// Category tier — composite rule. Alias: CategoryTier. Prefixes PRM/STD/ECN.
enum SampleCategory {
  PREMIUM
  STANDARD
  ECONOMY
}

/// Release-timing flag (orthogonal to Priority). Default QUARANTINE per ICMR donor semen.
enum SampleReleaseTiming {
  REGULAR
  QUARANTINE
}

/// 12-state andrology pipeline (A0–A10).
enum SampleState {
  DRAFT
  ACCESSIONED
  ANALYZED
  ADVANCED_TESTING
  DECIDED
  PREPARED
  VIALED
  CRYOPRESERVED
  QC_A5_PENDING
  QUARANTINE
  POST_THAW_ANALYZED
  CLOSED
}

model Sample {
  id         String @id @default(cuid())
  sampleCode String @unique
  donorId    String
  donor      Donor  @relation("SampleDonor", fields: [donorId], references: [id])
  siteId     String
  site       Site   @relation(fields: [siteId], references: [id])

  sampleType    SampleType           @default(QUARANTINE)
  priority      SamplePriority       @default(REGULAR)
  releaseTiming SampleReleaseTiming  @default(QUARANTINE)

  collectionDate     DateTime
  collectionTime     String
  abstinenceDays     Int
  collectionMethod   String  @default("MASTURBATION")
  collectionLocation String?
  deliveredToLabAt   DateTime?
  notes              String?

  // QC-A1 accession checks
  qcA1ContainerIntact   Boolean?
  qcA1IdMatch           Boolean?
  qcA1TimeUnder30       Boolean?
  qcA1CompleteEjaculate Boolean?

  // Macro (WHO 6th) — also exposed as macroVolume / macroPh in UI
  appearance          String?
  liquefactionTimeMin Int?
  viscosity           String?
  volumeML            Float? // macroVolume
  ph                  Float? // macroPh
  colour              String?
  semenFructose       Float?
  odour               String?

  // Micro (WHO 6th)
  concentrationMPerML           Float? // microConcentration
  totalSpermsMillion            Float?
  progressiveMotilityPct        Float? // microMotilityPR
  nonProgressiveMotilityPct     Float?
  totalMotilityPct              Float? // microMotilityTotal
  immotilePct                   Float?
  rapidPRPct                    Float?
  slowPRPct                     Float?
  totalMotileSpermsMillion      Float?
  totalRapidMotileSpermsMillion Float?
  morphologyNormalPct           Float? // microMorphology
  vitalityPct                   Float? // microVitality
  roundCellsPerML               Int?
  agglutinationGrade            String?
  aggregationGrade              String?
  rbcPresent                    Boolean?

  // Advanced tests
  dfiPct             Float? // dfi
  marTestPct         Float? // mar
  dsDnaBreakPct      Float? // dsDna
  semenCultureResult String? // semenCulture

  // Preparation / decision
  decisionOutcome     String? // DISCARD | RESCHEDULE | PROCEED
  prepMethod          String? // preparationMethod
  preppedAt           DateTime?
  postPrepMotilityPct Float?

  cryomedia    String?
  cryoProtocol String?
  cryoDate     DateTime?

  grade    SampleGrade?
  category SampleCategory?

  analysisVideoUrl String? // videoAssetUrl
  postThawVideoUrl String?
  qrPackUrl        String?
  testVialThawResult Float? // post-thaw PR % from QC-A5 test vial

  // Post-thaw 9-param (A9) — may reuse micro fields; dedicated snapshot:
  postThawConcentration Float?
  postThawRapidPRPct    Float?
  postThawSlowPRPct     Float?
  postThawNonProgPct    Float?
  postThawVitalityPct   Float?
  postThawMorphologyPct Float?
  postThawVolumeML      Float?

  state                      SampleState @default(DRAFT)
  quarantineStartDate        DateTime?
  quarantineEndDate          DateTime?
  postQuarantineSerologyPass Boolean?
  day165NotifiedAt           DateTime?

  vials     Vial[]
  auditLogs AuditLog[] @relation("AuditLogSample")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([donorId])
  @@index([sampleType, priority])
  @@index([releaseTiming, priority])
}

model Vial {
  id       String @id @default(cuid())
  vialCode String @unique
  sampleId String
  sample   Sample @relation(fields: [sampleId], references: [id])

  volumeML Float @default(0.5)

  // Location (currentTankId / canister / rack / position)
  tankId       String
  tank         CryoTank @relation(fields: [tankId], references: [id])
  canisterCode String
  rackCode     String
  positionCode String?

  category      SampleCategory?
  grade         SampleGrade?
  isQuarantined Boolean @default(false)

  isReleased            Boolean   @default(false)
  releasedAt            DateTime?
  isDispensed           Boolean   @default(false)
  dispensedAt           DateTime?
  dispensedToDispatchId String?
  isDiscarded           Boolean   @default(false)
  discardedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sampleId])
  @@index([tankId])
  @@index([isReleased, isDispensed])
  @@index([isQuarantined])
}

model CryoTank {
  id                String          @id @default(cuid())
  tankCode          String          @unique
  name              String
  location          String
  capacityCanisters Int
  temperatureC      Float           @default(-196)
  category          SampleCategory?
  isQuarantine      Boolean         @default(false)

  vials     Vial[]
  createdAt DateTime @default(now())
}

/// Per-site QC gate toggles + threshold overrides (QC-A6 is statutory — keep enabled).
model QcGateConfig {
  id                  String  @id @default(cuid())
  siteId              String
  site                Site    @relation(fields: [siteId], references: [id])
  gateName            String // QC_A1 … QC_A6, POST_THAW_CONC, POST_THAW_RAPID_PR, …
  isEnabled           Boolean @default(true)
  thresholdOverrides  Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([siteId, gateName])
  @@index([siteId])
}

/// Per-site category composite rules + default tank mapping.
model CategoryRuleConfig {
  id              String   @id @default(cuid())
  siteId          String   @unique
  site            Site     @relation(fields: [siteId], references: [id])
  rulesJson       Json // { premium: {...}, standard: {...}, economy: {...} }
  tankMappingJson Json // { PREMIUM: tankId, STANDARD: tankId, ECONOMY: tankId, QUARANTINE: tankId }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== CLINIC + CONTRACT =====

enum ClinicLevel {
  L1
  L2
}

enum FinancialModel {
  A
  B
  C
}

model Clinic {
  id                         String     @id @default(cuid())
  clinicCode                 String     @unique
  name                       String
  level                      ClinicLevel
  siteId                     String
  site                       Site       @relation(fields: [siteId], references: [id])
  artActRegistrationNumber   String?
  artActRegistrationExpiryAt DateTime?
  gstin                      String?
  panNumber                  String?
  addressLine                String
  city                       String
  stateCode                  String
  pincode                    String
  primaryContact             String
  primaryPhone               String
  primaryEmail               String

  contract   ClinicContract?
  users      User[]
  recipients Recipient[]
  drfs       DRF[]
  dispatches DispatchOrder[]
  cycleEvents CycleEvent[]

  /// Vienna KPI thresholds + future-Bank location toggles (all OFF by default)
  embryologyConfig Json?

  createdAt DateTime @default(now())
}

model ClinicContract {
  id               String         @id @default(cuid())
  clinicId         String         @unique
  clinic           Clinic         @relation(fields: [clinicId], references: [id])
  financialModel   FinancialModel @default(B)
  paymentTerms     String         @default("NET_30")
  advancePolicy    String         @default("PAY_ON_INVOICE")
  advanceSplitPct  Int?
  markupCapPct     Int?
  creditLimit      Decimal?       @db.Decimal(19, 4)
  badDebtThreshold Decimal?       @db.Decimal(19, 4)
  escalationEmail  String?
  courierVendor    String?
  isActive         Boolean        @default(true)
  contractStartAt  DateTime
  contractEndAt    DateTime?
}

// ===== RECIPIENT =====

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum SelectionMode {
  ANONYMOUS
  PROFILE_SELECT
}

model Recipient {
  id            String @id @default(cuid())
  recipientCode String @unique
  fullName      String
  partnerName   String?
  dob           DateTime?
  aadhaarHash   String?
  phone         String
  email         String
  addressLine   String?
  city          String?
  stateCode     String?
  pincode       String?

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  packageTier   PackageTier   @default(BASIC)
  selectionMode SelectionMode @default(ANONYMOUS)
  engineSubs    String[]

  /// Upstream Lead Management link (nullable)
  sourceLeadId String? @unique
  sourceLead   Lead?   @relation("LeadConvertedRecipient", fields: [sourceLeadId], references: [id])

  drfs      DRF[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== DRF (Donor Requisition Form) =====

/// 10-state DRF lifecycle (pull mechanism → outcome close).
enum DrfState {
  DRAFT
  SUBMITTED
  ACCEPTED
  ALLOCATED
  IN_TRANSIT
  DELIVERED
  IN_CYCLE
  OUTCOME_PENDING
  CLOSED
  CANCELLED
}

model DRF {
  id        String @id @default(cuid())
  drfNumber String @unique // LIF-{ClinicCode}-DRF-YYMMDD-NNNN · alias: drfCode
  /// Target fulfillment site (GSTIN / inventory)
  siteId    String
  site      Site   @relation(fields: [siteId], references: [id])
  /// Requesting clinic
  clinicId  String
  clinic    Clinic @relation(fields: [clinicId], references: [id])
  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id])

  /// Dispatch commodity type (6 types)
  type     DispatchType   @default(SEMEN_VIAL)
  priority SamplePriority @default(REGULAR)

  donorType          DonorType     @default(SEMEN)
  packageTier        PackageTier   @default(BASIC)
  selectionMode      SelectionMode @default(ANONYMOUS)
  engineSubs         String[]
  clinicalIndication String?
  notes              String?

  requestedQuantity Int               @default(1)
  filterCategory    SampleCategory?
  filterGrade       SampleGrade?

  doctorUserId          String?
  doctorArtActRegNumber String?
  doctorSignedAt        DateTime?

  financialModelApplied FinancialModel @default(B)

  state          DrfState @default(DRAFT)
  submittedAt    DateTime?
  acceptedAt     DateTime?
  rejectedReason String?

  allocatedDonorId          String?
  assignedVialIds           Json? // string[] of Vial IDs
  allocatedAt               DateTime?
  bidirectionalTagWrittenAt DateTime?
  dispatchedAt              DateTime?
  deliveredAt               DateTime?
  expectedDeliveryAt        DateTime?

  outcomeType       String?
  outcomeReportedAt DateTime?

  dispatches DispatchOrder[]
  challans   Challan[]
  cohort     EmbryoCohort?
  invoices   Invoice[]
  cycleEvents  CycleEvent[]
  outcomeNudges OutcomeNudge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([clinicId])
  @@index([type, priority])
}

// ===== DISPATCH =====

enum DispatchType {
  SEMEN_VIAL
  OOCYTE_FRESH
  OOCYTE_VITRIFIED
  EMBRYO_FRESH
  EMBRYO_VITRIFIED
  ANCILLARY_SUPPLIES
}

/// DispatchOrder states mirror the DRF 10-state machine.
enum DispatchOrderState {
  DRAFT
  SUBMITTED
  ACCEPTED
  ALLOCATED
  IN_TRANSIT
  DELIVERED
  IN_CYCLE
  OUTCOME_PENDING
  CLOSED
  CANCELLED
}

model DispatchOrder {
  id             String @id @default(cuid())
  dispatchNumber String @unique // LIF-{Site}-DSP-YYMMDD-NNNN · alias: dispatchCode
  siteId         String
  site           Site   @relation(fields: [siteId], references: [id])
  drfId          String?
  drf            DRF?   @relation(fields: [drfId], references: [id])
  clinicId       String
  clinic         Clinic @relation(fields: [clinicId], references: [id])

  type     DispatchType
  state    DispatchOrderState @default(DRAFT)
  priority SamplePriority     @default(REGULAR)

  vialIds String[]
  donorId String?

  courierVendor     String?
  courierTrackingId String?
  temperatureLogUrl String?
  podUrl            String?
  chainOfCustodyLog Json? // [{at, actorUserId, action, note}]

  travelMode       String?
  travelBookingRef String?
  accommodationRef String?
  escortUserId     String?

  scheduledAt  DateTime?
  packedAt     DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  receivedAt   DateTime?

  challans Challan[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([drfId])
  @@index([clinicId])
}

// ===== BILLING (Challan → Invoice → Payment) =====

model SKU {
  id           String  @id @default(cuid())
  code         String  @unique
  description  String
  type         String
  hsnSacCode   String
  gstRatePct   Decimal @default(18) @db.Decimal(19, 4)
  revenueClass String
  defaultPrice Decimal @db.Decimal(19, 4)
  isActive     Boolean @default(true)
}

enum ChallanStatus {
  RAISED
  ACKNOWLEDGED
  CONVERTED_TO_INVOICE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  RAISED
  PAID_FULL
  PAID_PARTIAL
  OVERDUE
  CREDITED
  VOID
}

enum PaymentMode {
  UPI
  CARD
  NETBANKING
  WALLET
  EMI
  NEFT
  RTGS
  IMPS
  CASH
  CHEQUE
}

enum PaymentMethod {
  RAZORPAY
  PAYU
  BANK_TRANSFER
  CHEQUE
  CASH
  CREDIT_NOTE
  ADJUSTMENT
}

enum PaymentGatewayStatus {
  INITIATED
  PROCESSING
  CAPTURED
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum DunningStage {
  NONE
  REMINDER_1
  REMINDER_2
  FINAL_NOTICE
  ESCALATED
  WRITE_OFF
}

model Challan {
  id            String @id @default(cuid())
  challanNumber String @unique
  siteId        String
  site          Site   @relation(fields: [siteId], references: [id])
  dispatchId    String?
  dispatch      DispatchOrder? @relation(fields: [dispatchId], references: [id])
  drfId         String?
  drf           DRF?           @relation(fields: [drfId], references: [id])

  gstin     String
  buyerType String
  buyerId   String

  totalValue   Decimal @db.Decimal(19, 4)
  taxableValue Decimal @db.Decimal(19, 4)
  totalGst     Decimal @db.Decimal(19, 4)
  totalWithGst Decimal @db.Decimal(19, 4)

  status               ChallanStatus @default(RAISED)
  issuedAt             DateTime      @default(now())
  convertedToInvoiceAt DateTime?

  invoice   Invoice?          @relation("ChallanInvoice")
  lineItems ChallanLineItem[]

  @@index([status])
  @@index([drfId])
}

model ChallanLineItem {
  id           String  @id @default(cuid())
  challanId    String
  challan      Challan @relation(fields: [challanId], references: [id])
  skuCode      String
  description  String
  quantity     Decimal @db.Decimal(19, 4)
  unitPrice    Decimal @db.Decimal(19, 4)
  discount     Decimal @default(0) @db.Decimal(19, 4)
  taxableValue Decimal @db.Decimal(19, 4)
  gstRatePct   Decimal @db.Decimal(19, 4)
  igst         Decimal @default(0) @db.Decimal(19, 4)
  cgst         Decimal @default(0) @db.Decimal(19, 4)
  sgst         Decimal @default(0) @db.Decimal(19, 4)
  lineTotal    Decimal @db.Decimal(19, 4)
}

model Invoice {
  id              String  @id @default(cuid())
  invoiceNumber   String  @unique
  siteId          String
  site            Site    @relation(fields: [siteId], references: [id])
  parentChallanId String? @unique
  parentChallan   Challan? @relation("ChallanInvoice", fields: [parentChallanId], references: [id])

  drfId      String?
  drf        DRF?           @relation(fields: [drfId], references: [id])
  dispatchId String?
  dispatch   DispatchOrder? @relation(fields: [dispatchId], references: [id])

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  gstin                    String
  buyerType                String
  buyerId                  String
  placeOfSupplyStateCode   String

  totalValue   Decimal @db.Decimal(19, 4)
  taxableValue Decimal @db.Decimal(19, 4)
  totalGst     Decimal @db.Decimal(19, 4)
  totalWithGst Decimal @db.Decimal(19, 4)
  tdsAmount    Decimal @default(0) @db.Decimal(19, 4)
  tcsAmount    Decimal @default(0) @db.Decimal(19, 4)
  netPayable   Decimal @db.Decimal(19, 4)

  paymentTerms String
  dueDate      DateTime

  irn       String?
  qrCodeUrl String?

  gatewayOrderId   String?
  gatewayPaymentId String?
  dunningStage     DunningStage @default(NONE)

  status   InvoiceStatus @default(RAISED)
  issuedAt DateTime      @default(now())
  paidAt   DateTime?

  lineItems   InvoiceLineItem[]
  payments    Payment[]
  creditNotes CreditNote[]

  @@index([status])
  @@index([dueDate])
  @@index([dunningStage])
  @@index([subscriptionId])
  @@index([gatewayPaymentId])
}

model InvoiceLineItem {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id])
  skuCode      String
  description  String
  quantity     Decimal @db.Decimal(19, 4)
  unitPrice    Decimal @db.Decimal(19, 4)
  discount     Decimal @default(0) @db.Decimal(19, 4)
  taxableValue Decimal @db.Decimal(19, 4)
  gstRatePct   Decimal @db.Decimal(19, 4)
  igst         Decimal @default(0) @db.Decimal(19, 4)
  cgst         Decimal @default(0) @db.Decimal(19, 4)
  sgst         Decimal @default(0) @db.Decimal(19, 4)
  lineTotal    Decimal @db.Decimal(19, 4)
}

model Payment {
  id                  String      @id @default(cuid())
  paymentNumber       String      @unique
  invoiceId           String
  invoice             Invoice     @relation(fields: [invoiceId], references: [id])
  amount              Decimal     @db.Decimal(19, 4)
  method              PaymentMethod @default(BANK_TRANSFER)
  mode                PaymentMode?
  gateway             String?
  gatewayTxnId        String?     @unique
  gatewayStatus       PaymentGatewayStatus?
  referenceNumber     String?
  notes               String?
  paidAt              DateTime
  reconciledAt        DateTime?
  reconciliationLevel String?
  bankRef             String?

  @@index([invoiceId])
  @@index([method])
  @@index([paidAt])
}

model CreditNote {
  id                String   @id @default(cuid())
  creditNoteNumber  String   @unique
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id])
  amount            Decimal  @db.Decimal(19, 4)
  reasonCode        String
  reasonNote        String?
  approvedBy        String?
  issuedAt          DateTime @default(now())
  refundInitiatedAt DateTime?
  refundCompletedAt DateTime?
}

model PaymentGatewayLog {
  id               String   @id @default(cuid())
  gateway          String // RAZORPAY | PAYU
  eventType        String
  gatewayPaymentId String?
  gatewayOrderId   String?
  invoiceId        String?
  payload          Json
  signatureValid   Boolean?
  processed        Boolean  @default(false)
  errorMessage     String?
  receivedAt       DateTime @default(now())

  @@index([gateway, gatewayPaymentId])
  @@index([invoiceId])
  @@index([receivedAt])
}

// ===== SUBSCRIPTIONS =====

enum SubscriptionType {
  STORAGE_ANNUAL
  STORAGE_MONTHLY
  MEMBERSHIP_BASIC
  MEMBERSHIP_PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  DUNNING
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String             @unique
  type               SubscriptionType
  frequency          BillingFrequency
  skuCode            String
  subscriberType     String // CLINIC | RECIPIENT
  subscriberId       String
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime           @default(now())
  nextBillingAt      DateTime
  endedAt            DateTime?
  autoPayEnabled     Boolean            @default(false)
  autoPayMandateId   String?
  quantity           Int                @default(1)
  unitAmount         Decimal            @db.Decimal(19, 4)
  gstAmount          Decimal            @default(0) @db.Decimal(19, 4)
  totalAmount        Decimal            @db.Decimal(19, 4)
  siteId             String?
  notes              String?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([subscriberType, subscriberId])
  @@index([nextBillingAt])
}

// ===== EMBRYOLOGY =====

enum OocyteMaturity {
  MII
  MI
  GV
}

enum EmbryoDisposition {
  CULTURE
  VITRIFIED
  TRANSFERRED
  DISCARDED_ABNORMAL
  DISCARDED_ARREST
}

enum CycleEventType {
  STIM_MONITORING
  OPU_COMPLETED
  OOCYTES_RETRIEVED
  FERTILIZATION
  DAY1_CHECK
  DAY3_GRADE
  DAY5_GRADE
  PGT_RESULT
  TRANSFER
  VITRIFICATION
  BETA_HCG
  CLINICAL_PREGNANCY
  LIVE_BIRTH
  CYCLE_CANCELLED
}

enum CycleOutcome {
  PREGNANT
  NOT_PREGNANT
  CANCELLED
  CLOSED_NO_OUTCOME
}

enum BetaHcgResult {
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
}

enum PgtResult {
  EUPLOID
  ANEUPLOID
  MOSAIC
  NO_RESULT
}

enum CycleLocation {
  BANK
  L1
  L2
}

enum NudgeStatus {
  PENDING
  SENT
  SKIPPED
}

/// Append-only clinical event log for L2 cycle tracking (Bank coordination role).
model CycleEvent {
  id          String         @id @default(cuid())
  drfId       String
  drf         DRF            @relation(fields: [drfId], references: [id])
  eventType   CycleEventType
  occurredAt  DateTime
  payload     Json
  actorUserId String?
  clinicId    String
  clinic      Clinic         @relation(fields: [clinicId], references: [id])
  location    CycleLocation  @default(L2)
  createdAt   DateTime       @default(now())

  @@index([drfId, occurredAt])
  @@index([clinicId])
  @@index([eventType])
}

model OutcomeNudge {
  id          String      @id @default(cuid())
  drfId       String
  drf         DRF         @relation(fields: [drfId], references: [id])
  dayOffset   Int // 14 | 30 | 90 | 180
  scheduledAt DateTime
  sentAt      DateTime?
  status      NudgeStatus @default(PENDING)
  createdAt   DateTime    @default(now())

  @@unique([drfId, dayOffset])
  @@index([status, scheduledAt])
}

model EmbryoCohort {
  id       String @id @default(cuid())
  drfId    String @unique
  drf      DRF    @relation(fields: [drfId], references: [id])
  clinicId String

  startedAt             DateTime  @default(now())
  opuAt                 DateTime?
  oocytesRetrieved      Int?
  /// Legacy alias kept in sync with oocytesRetrieved
  totalOocytesRetrieved Int?
  miiCount              Int? @map("mIICount")
  miCount               Int?
  gvCount               Int?
  day1_2pnCount         Int?
  day3CleavedCount      Int?
  day5BlastCount        Int?
  transferredCount      Int? @default(0)
  vitrifiedCount        Int? @default(0)
  discardedCount        Int? @default(0)

  outcome           CycleOutcome?
  outcomeReportedAt DateTime?
  closedAt          DateTime?
  currentPhase      String        @default("E0") // E0–E9

  embryos   Embryo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Embryo {
  id       String       @id @default(cuid())
  cohortId String
  cohort   EmbryoCohort @relation(fields: [cohortId], references: [id])

  /// Oocyte / embryo reference code (OCT-YYMM-CCC-NN)
  oocyteId         String            @unique
  oocyteRef        String?
  oocyteMaturity   OocyteMaturity?   @map("maturity")
  day1_2pn         Boolean?          @map("day1TwoPN")
  day3CellCount    Int?
  day3FragPct      Int?
  day3Grade        String?
  day5Gardner      String?
  pgtTriggered     Boolean           @default(false)
  pgtResult        PgtResult?
  disposition      EmbryoDisposition?
  storageRef       String?
  vitrificationLoc String?
  transferredAt    DateTime?         @map("transferAt")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cohortId])
  @@index([disposition])
}

// ===== DONATION RECORD (Phase 4 MRD) =====

model DonationRecord {
  id                String    @id @default(cuid())
  donorId           String
  donor             Donor     @relation(fields: [donorId], references: [id])
  sampleId          String?
  drfId             String?
  outcomeType       String?
  outcomeReportedAt DateTime?
  registrySync      Boolean   @default(false)
  registrySyncedAt  DateTime?
  createdAt         DateTime  @default(now())
}

// ===== AUDIT + EVENTS =====

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  hashChain   String?

  donor      Donor?  @relation("AuditLogDonor", fields: [donorRelId], references: [id])
  donorRelId String?
  sample     Sample? @relation("AuditLogSample", fields: [sampleRelId], references: [id])
  sampleRelId String?

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([actorUserId])
}

model EventEmission {
  id             String    @id @default(cuid())
  eventName      String
  payload        Json
  targetSystem   String?
  emittedAt      DateTime  @default(now())
  consumedAt     DateTime?
  consumerStatus String?
  retryCount     Int       @default(0)

  @@index([eventName])
  @@index([consumerStatus])
}

// ===== SEEDSCORE (7-Chakra wellness engine) =====

enum ChakraType {
  ROOT
  SACRAL
  SOLAR_PLEXUS
  HEART
  THROAT
  THIRD_EYE
  CROWN
}

enum SeedScoreTier {
  PREMIUM
  STANDARD
  REGULAR
  NOT_RECOMMENDED
  UNSCORED
}

enum RecalcTrigger {
  INTAKE_COMPLETION
  LAB_RESULTS
  POST_DONATION
  SCHEDULED_6M
  MANUAL_BRM
  DONOR_SELF_UPDATE
  RUBRIC_UPDATE
}

model ChakraQuestion {
  id           String    @id @default(cuid())
  chakra       ChakraType
  donorType    DonorType
  questionCode String
  questionText String
  orderIndex   Int
  isActive     Boolean   @default(true)
  /// Merged-chakra facet e.g. psychological | genetic | medico_legal
  subDimension String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdByUserId String?
  createdBy    User?     @relation("ChakraQuestionAuthor", fields: [createdByUserId], references: [id])

  options ChakraRubricOption[]
  answers SeedScoreAnswer[]

  @@unique([chakra, donorType, questionCode])
  @@index([chakra, donorType, isActive])
}

model ChakraRubricOption {
  id         String         @id @default(cuid())
  questionId String
  question   ChakraQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionCode String
  optionText String
  scoreValue Int // 0–10
  orderIndex Int
  isActive   Boolean        @default(true)

  answers SeedScoreAnswer[]

  @@unique([questionId, optionCode])
  @@index([questionId])
}

/// One CURRENT score per donor (history archived to SeedScoreHistory).
model SeedScore {
  id                 String        @id @default(cuid())
  donorId            String        @unique
  donor              Donor         @relation("SeedScoreOwner", fields: [donorId], references: [id])
  pointedByDonor     Donor?        @relation("DonorCurrentScoreRef")

  totalScore         Int
  tier               SeedScoreTier
  rootScore          Int
  sacralScore        Int
  solarPlexusScore   Int
  heartScore         Int
  throatScore        Int
  thirdEyeScore      Int // max 16
  crownScore         Int
  recalcTrigger      RecalcTrigger
  computedAt         DateTime      @default(now())
  computedByUserId   String?
  rubricVersion      String

  answers SeedScoreAnswer[]

  @@index([tier])
  @@index([computedAt])
}

model SeedScoreHistory {
  id                   String        @id @default(cuid())
  donorId              String
  donor                Donor         @relation(fields: [donorId], references: [id])
  versionNumber        Int
  totalScore           Int
  tier                 SeedScoreTier
  rootScore            Int
  sacralScore          Int
  solarPlexusScore     Int
  heartScore           Int
  throatScore          Int
  thirdEyeScore        Int
  crownScore           Int
  recalcTrigger        RecalcTrigger
  computedAt           DateTime
  computedByUserId     String?
  rubricVersion        String
  supersededAt         DateTime?
  supersededByScoreId  String?

  @@unique([donorId, versionNumber])
  @@index([donorId, computedAt])
}

model SeedScoreAnswer {
  id                String              @id @default(cuid())
  seedScoreId       String
  seedScore         SeedScore           @relation(fields: [seedScoreId], references: [id], onDelete: Cascade)
  questionId        String
  question          ChakraQuestion      @relation(fields: [questionId], references: [id])
  selectedOptionId  String
  selectedOption    ChakraRubricOption  @relation(fields: [selectedOptionId], references: [id])
  notes             String?
  answeredByUserId  String?

  @@unique([seedScoreId, questionId])
  @@index([seedScoreId])
}

model RubricVersion {
  id               String   @id @default(cuid())
  versionNumber    Int      @unique
  publishedAt      DateTime @default(now())
  publishedByUserId String?
  publishedBy      User?    @relation("RubricVersionPublisher", fields: [publishedByUserId], references: [id])
  isActive         Boolean  @default(false)
  notes            String?

  @@index([isActive])
}

// ===== LEAD MANAGEMENT (upstream of Donor Pathway + Recipient acquisition) =====

enum LeadPersonType {
  DONOR
  RECIPIENT
}

enum LeadDonorSubType {
  SEMEN
  OOCYTE
}

enum LeadSource {
  WEB_FORM
  WHATSAPP_BOT
  PHONE_INBOUND
  WALK_IN
  REFERRAL
  SOCIAL_FACEBOOK
  SOCIAL_INSTAGRAM
  SOCIAL_GOOGLE_ADS
  CLINIC_REFERRAL
  PARTNER_HOSPITAL
  OTHER
}

enum LeadTier {
  HOT
  WARM
  COLD
  ARCHIVED
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED_QUALIFIED
  CONTACTED_NOT_INTERESTED
  CONTACTED_CALLBACK_REQUESTED
  NOT_REACHABLE
  WRONG_NUMBER
  DO_NOT_CALL
  COUNSELLING_BOOKED
  COUNSELLING_ATTENDED
  COUNSELLING_NO_SHOW
  CONVERTED
  LOST
  EXPIRED_AUTO_PURGED
}

enum CallDispositionType {
  CONTACTED_QUALIFIED
  CONTACTED_NOT_INTERESTED
  CONTACTED_CALLBACK_REQUESTED
  NOT_REACHABLE
  WRONG_NUMBER
  DO_NOT_CALL
  LOST
}

enum CounsellingMode {
  IN_PERSON
  VIDEO_CALL
  PHONE
}

enum CounsellingBookingStatus {
  BOOKED
  ATTENDED
  NO_SHOW
  RESCHEDULED
  CANCELLED
}

enum SlaStatus {
  PENDING
  ACTIVE
  WARNING_25PCT
  WARNING_50PCT
  BREACHED
  COMPLETED
}

enum SlaEntityType {
  LEAD_RESPONSE
  LEAD_QUALIFICATION
  COUNSELLING_BOOKING
  COUNSELLING_REMINDER
  DONOR_SCREENING
  DONOR_CONSENT
  EMBRYOLOGY_OUTCOME
}

enum CrmSyncStatus {
  PENDING
  SYNCED
  FAILED
  RETRYING
  SKIPPED
}

enum CrmEntityType {
  LEAD
  DONOR
  RECIPIENT
}

enum CrmSyncTarget {
  ZOHO
  SALESFORCE
}

enum DncSource {
  SELF_REQUEST
  OPS_ADD
  COMPLIANCE_ADD
}

model Lead {
  id               String            @id @default(cuid())
  leadCode         String            @unique
  personType       LeadPersonType
  donorSubType     LeadDonorSubType?
  source           LeadSource
  sourceMetadata   Json?
  capturedAt       DateTime          @default(now())
  fullName         String?
  phone            String?
  phoneCountryCode String            @default("+91")
  email            String?
  city             String?
  state            String?
  pincode          String?
  ageGroup         String?
  preferredLanguage String?
  score            Int               @default(0)
  scoreBreakdown   Json?
  tier             LeadTier          @default(COLD)
  status           LeadStatus        @default(NEW)

  assignedTelecallerId String?
  assignedTelecaller   User?     @relation("LeadTelecaller", fields: [assignedTelecallerId], references: [id])
  assignedAt           DateTime?

  slaResponseDueAt DateTime?
  slaQualifyDueAt  DateTime?

  convertedDonorId     String? @unique
  convertedRecipientId String? @unique
  convertedAt          DateTime?
  convertedByUserId    String?
  lostReason           String?
  doNotCallFlag        Boolean @default(false)

  consentMarketing       Boolean @default(false)
  consentScreening       Boolean @default(false)
  consentDataProcessing  Boolean @default(false)
  consentVersion         String?
  consentIp              String?
  consentUserAgent       String?

  retentionExpiresAt DateTime?
  lastActivityAt     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  callDispositions    CallDisposition[]
  counsellingBooking  CounsellingBooking?
  convertedDonor      Donor?     @relation("LeadConvertedDonor")
  convertedRecipient  Recipient? @relation("LeadConvertedRecipient")

  @@index([status])
  @@index([tier])
  @@index([personType])
  @@index([assignedTelecallerId])
  @@index([retentionExpiresAt])
  @@index([phone])
}

model CallDisposition {
  id              String               @id @default(cuid())
  leadId          String
  lead            Lead                 @relation(fields: [leadId], references: [id])
  telecallerId    String
  telecaller      User                 @relation("CallDispositionTelecaller", fields: [telecallerId], references: [id])
  callStartedAt   DateTime
  callEndedAt     DateTime?
  durationSeconds Int?
  disposition     CallDispositionType
  notes           String?
  followupAt      DateTime?
  qaScore         Int?
  qaSampledByUserId String?
  qaSampledAt     DateTime?
  recordingUrl    String?
  createdAt       DateTime             @default(now())

  @@index([leadId])
  @@index([telecallerId])
}

model CounsellingBooking {
  id              String                   @id @default(cuid())
  leadId          String                   @unique
  lead            Lead                     @relation(fields: [leadId], references: [id])
  bookedAt        DateTime                 @default(now())
  scheduledAt     DateTime
  durationMinutes Int                      @default(30)
  mode            CounsellingMode
  counsellorUserId String
  counsellor      User                     @relation("CounsellingCounsellor", fields: [counsellorUserId], references: [id])
  meetingUrl      String?
  meetingLocation String?
  reminderSentAt  DateTime?
  status          CounsellingBookingStatus @default(BOOKED)
  attendedAt      DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  followupNotes   String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([counsellorUserId, scheduledAt])
  @@index([status])
}

model SlaSchedule {
  id                   String       @id @default(cuid())
  entityType           SlaEntityType
  entityId             String
  stageKey             String
  startedAt            DateTime
  responseWithinHours  Int
  completeWithinHours  Int?
  responseDueAt        DateTime
  completeDueAt        DateTime?
  respondedAt          DateTime?
  completedAt          DateTime?
  status               SlaStatus    @default(ACTIVE)
  lastEscalationLevel  Int          @default(0)
  lastEscalationAt     DateTime?
  escalationLadder     Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status, responseDueAt])
  @@index([entityType, entityId])
  @@unique([entityType, entityId, stageKey])
}

model CrmSyncQueue {
  id            String        @id @default(cuid())
  entityType    CrmEntityType
  entityId      String
  syncTarget    CrmSyncTarget
  payload       Json
  status        CrmSyncStatus @default(PENDING)
  attempts      Int           @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  scheduledFor  DateTime      @default(now())
  succeededAt   DateTime?
  createdAt     DateTime      @default(now())

  @@index([status, scheduledFor])
  @@index([entityType, entityId])
}

model LeadDoNotCallList {
  id          String    @id @default(cuid())
  phone       String    @unique
  email       String?
  reason      String
  addedByUserId String?
  addedBy     User?     @relation("DncAddedBy", fields: [addedByUserId], references: [id])
  addedAt     DateTime  @default(now())
  expiresAt   DateTime?
  source      DncSource @default(OPS_ADD)

  @@index([email])
}

// ===== REPORTS MODULE (v1 · additive-only · read-only across platform) =====

enum ReportCategory {
  CLINICAL
  FINANCE
  LOGISTICS
  COMPLIANCE
  REGULATORY
  OPERATIONAL
}

enum ReportCadence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM
  ON_DEMAND
}

enum ReportExportFormat {
  CSV
  XLSX
  PDF
  JSON
}

enum ReportDeliveryChannel {
  EMAIL
  WHATSAPP
  DOWNLOAD_LINK
}

enum ReportTriggeredBy {
  MANUAL
  SCHEDULED
  API
}

model ReportSchedule {
  id                   String                @id @default(cuid())
  reportId             String
  cadence              ReportCadence
  filterValues         Json
  exportFormat         ReportExportFormat
  subscriberUserIds    String[]
  deliveryChannel      ReportDeliveryChannel @default(EMAIL)
  isActive             Boolean               @default(true)
  createdByUserId      String
  createdBy            User                  @relation("ReportScheduleCreator", fields: [createdByUserId], references: [id])
  nextRunAt            DateTime?
  lastRunAt            DateTime?
  /// Frequency detail: IST hour/minute, day of week/month, quarter month, cron.
  scheduleDetail       Json?
  dataWindowPreset     String?
  dataWindowCustomFrom DateTime?
  dataWindowCustomTo   DateTime?
  comparePreset        String?
  compareCustomFrom    DateTime?
  compareCustomTo      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  runs ReportRun[]

  @@index([reportId])
  @@index([nextRunAt, isActive])
  @@index([createdByUserId])
}

model ReportRun {
  id             String              @id @default(cuid())
  reportId       String
  runByUserId    String?
  runBy          User?               @relation("ReportRunActor", fields: [runByUserId], references: [id])
  triggeredBy    ReportTriggeredBy
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  rowCount       Int?
  exportFormat   ReportExportFormat?
  exportUrl      String?
  errorMessage   String?
  filterSnapshot Json
  scheduleId     String?
  schedule       ReportSchedule?     @relation(fields: [scheduleId], references: [id])

  deliveries ReportDeliveryLog[]

  @@index([reportId])
  @@index([startedAt])
  @@index([scheduleId])
}

model ReportDeliveryLog {
  id               String                @id @default(cuid())
  reportRunId      String
  reportRun        ReportRun             @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  subscriberUserId String
  subscriber       User                  @relation(fields: [subscriberUserId], references: [id])
  channel          ReportDeliveryChannel
  attemptedAt      DateTime              @default(now())
  succeeded        Boolean               @default(false)
  errorMessage     String?

  @@index([reportRunId])
  @@index([subscriberUserId])
}

model ReportSnapshot {
  id                String   @id @default(cuid())
  reportId          String
  snapshotName      String
  capturedAt        DateTime @default(now())
  capturedByUserId  String
  capturedBy        User     @relation("ReportSnapshotCapture", fields: [capturedByUserId], references: [id])
  dataUrl           String
  filterSnapshot    Json
  isImmutable       Boolean  @default(true)
  retentionExpiresAt DateTime?
  notes             String?

  @@index([reportId])
  @@index([capturedAt])
}

model ReportFavorite {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId     String
  savedFilters Json?
  displayName  String
  createdAt    DateTime @default(now())

  @@unique([userId, reportId, displayName])
  @@index([userId])
}
