model Lead {
  id               String            @id @default(cuid())
  leadCode         String            @unique
  personType       LeadPersonType
  donorSubType     LeadDonorSubType?
  source           LeadSource
  sourceMetadata   Json?
  capturedAt       DateTime          @default(now())
  fullName         String?
  phone            String?
  phoneCountryCode String            @default("+91")
  email            String?
  city             String?
  state            String?
  pincode          String?
  ageGroup         String?
  preferredLanguage String?
  score            Int               @default(0)
  scoreBreakdown   Json?
  tier             LeadTier          @default(COLD)
  status           LeadStatus        @default(NEW)

  assignedTelecallerId String?
  assignedTelecaller   User?     @relation("LeadTelecaller", fields: [assignedTelecallerId], references: [id])
  assignedAt           DateTime?

  slaResponseDueAt DateTime?
  slaQualifyDueAt  DateTime?

  convertedDonorId     String? @unique
  convertedRecipientId String? @unique
  convertedAt          DateTime?
  convertedByUserId    String?
  lostReason           String?
  doNotCallFlag        Boolean @default(false)

  consentMarketing       Boolean @default(false)
  consentScreening       Boolean @default(false)
  consentDataProcessing  Boolean @default(false)
  consentVersion         String?
  consentIp              String?
  consentUserAgent       String?

  retentionExpiresAt DateTime?
  lastActivityAt     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  /// v2.1 additive (B01) — no renames / drops
  outcome              LeadOutcome?
  isArchived           Boolean      @default(false)
  archivedAt           DateTime?
  archivedByUserId     String?
  archivedBy           User?        @relation("LeadArchivedBy", fields: [archivedByUserId], references: [id])
  archiveReason        String?
  campaignId           String?
  campaign             Campaign?    @relation(fields: [campaignId], references: [id])
  latestScoreId        String?      @unique
  latestScore          LeadScore?   @relation("LeadLatestScore", fields: [latestScoreId], references: [id])
  latestScoreValue     Int?
  activeAssignmentId   String?      @unique
  activeAssignment     LeadAssignment? @relation("LeadActiveAssignment", fields: [activeAssignmentId], references: [id])
  mergedIntoLeadId     String?
  mergedInto           Lead?        @relation("LeadMergedInto", fields: [mergedIntoLeadId], references: [id])
  mergeLosers          Lead[]       @relation("LeadMergedInto")
  duplicateOfLeadId    String?
  duplicateOf          Lead?        @relation("LeadDuplicateOf", fields: [duplicateOfLeadId], references: [id])
  duplicateMarkers     Lead[]       @relation("LeadDuplicateOf")
  redactedAt           DateTime?
  redactionReason      String?
  version              Int          @default(1)

  callDispositions     CallDisposition[]
  counsellingBooking   CounsellingBooking?
  counsellingSessions  CounsellingSession[]
  counsellingOutcomes  CounsellingOutcome[]
  convertedDonor       Donor?     @relation("LeadConvertedDonor")
  convertedRecipient   Recipient? @relation("LeadConvertedRecipient")
  activities           LeadActivity[]
  statusHistory        LeadStatusHistory[]
  scores               LeadScore[]          @relation("LeadScoreHistory")
  assignments          LeadAssignment[]     @relation("LeadAssignmentHistory")
  followUps            LeadFollowUp[]
  attribution          LeadAttribution?
  attributionHistory   LeadAttributionHistory[]
  duplicateCasesLeft   DuplicateCase[]      @relation("DuplicateCaseLeft")
  duplicateCasesRight  DuplicateCase[]      @relation("DuplicateCaseRight")
  mergesAsWinner       LeadMerge[]          @relation("LeadMergeWinner")
  mergesAsLoser        LeadMerge[]          @relation("LeadMergeLoser")
  conversionRecord     LeadConversion?
  notificationLogs     NotificationDeliveryLog[]

  @@index([status])
  @@index([tier])
  @@index([personType])
  @@index([assignedTelecallerId])
  @@index([retentionExpiresAt])
  @@index([phone])
  @@index([email])
  @@index([isArchived])
  @@index([campaignId, capturedAt])
  @@index([assignedTelecallerId, status])
  @@index([mergedIntoLeadId])
}

/// Per city+UTC-day sequence for LED-{CITY}-{YYYYMMDD}-{XXXX} (B03).
model LeadCodeSequence {
  cityCode       String   @map("city_code")
  day            DateTime @map("day") @db.Date
  lastUsedNumber Int      @default(0) @map("last_used_number")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([cityCode, day])
  @@map("lead_code_sequences")
}

model CallDisposition {
  id              String               @id @default(cuid())
  leadId          String
  lead            Lead                 @relation(fields: [leadId], references: [id])
  telecallerId    String
  telecaller      User                 @relation("CallDispositionTelecaller", fields: [telecallerId], references: [id])
  callStartedAt   DateTime
  callEndedAt     DateTime?
  durationSeconds Int?
  disposition     CallDispositionType
  notes           String?
  followupAt      DateTime?
  qaScore         Int?
  qaSampledByUserId String?
  qaSampledAt     DateTime?
  recordingUrl    String?
  createdAt       DateTime             @default(now())

  activityId      String?
  activity        LeadActivity?        @relation(fields: [activityId], references: [id])
  followUpId      String?
  followUp        LeadFollowUp?        @relation(fields: [followUpId], references: [id])

  @@index([leadId])
  @@index([telecallerId])
}

model CounsellingBooking {
  id              String                   @id @default(cuid())
  leadId          String                   @unique
  lead            Lead                     @relation(fields: [leadId], references: [id])
  bookedAt        DateTime                 @default(now())
  scheduledAt     DateTime
  durationMinutes Int                      @default(30)
  mode            CounsellingMode
  counsellorUserId String
  counsellor      User                     @relation("CounsellingCounsellor", fields: [counsellorUserId], references: [id])
  meetingUrl      String?
  meetingLocation String?
  reminderSentAt  DateTime?
  status          CounsellingBookingStatus @default(BOOKED)
  attendedAt      DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  followupNotes   String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  bookingStatus            BookingStatus @default(SCHEDULED)
  rescheduledFromBookingId String?
  rescheduledFrom          CounsellingBooking?  @relation("BookingReschedule", fields: [rescheduledFromBookingId], references: [id])
  rescheduledTo            CounsellingBooking[] @relation("BookingReschedule")
  cancelledByUserId        String?
  cancelledBy              User?         @relation("CounsellingCancelledBy", fields: [cancelledByUserId], references: [id])
  sessions                 CounsellingSession[]

  @@index([counsellorUserId, scheduledAt])
  @@index([status])
  @@index([bookingStatus])
}

model SlaSchedule {
  id                   String       @id @default(cuid())
  entityType           SlaEntityType
  entityId             String
  stageKey             String
  startedAt            DateTime
  responseWithinHours  Int
  completeWithinHours  Int?
  responseDueAt        DateTime
  completeDueAt        DateTime?
  respondedAt          DateTime?
  completedAt          DateTime?
  status               SlaStatus    @default(ACTIVE)
  lastEscalationLevel  Int          @default(0)
  lastEscalationAt     DateTime?
  escalationLadder     Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  leadFollowUps        LeadFollowUp[]

  @@index([status, responseDueAt])
  @@index([entityType, entityId])
  @@unique([entityType, entityId, stageKey])
}

model CrmSyncQueue {
  id            String        @id @default(cuid())
  entityType    CrmEntityType
  entityId      String
  syncTarget    CrmSyncTarget
  payload       Json
  status        CrmSyncStatus @default(PENDING)
  attempts      Int           @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  scheduledFor  DateTime      @default(now())
  succeededAt   DateTime?
  createdAt     DateTime      @default(now())

  outboxEventId    String?
  outboxEvent      LeadOutboxEvent? @relation(fields: [outboxEventId], references: [id])
  operation        CrmOperation?
  payloadVersion   Int             @default(1)
  externalId       String?
  lastAttemptError String?

  @@index([status, scheduledFor])
  @@index([entityType, entityId])
}

model LeadDoNotCallList {
  id          String    @id @default(cuid())
  phone       String    @unique
  email       String?
  reason      String
  addedByUserId String?
  addedBy     User?     @relation("DncAddedBy", fields: [addedByUserId], references: [id])
  addedAt     DateTime  @default(now())
  expiresAt   DateTime?
  source      DncSource @default(OPS_ADD)

  @@index([email])
}

model LeadActivity {
  id                String            @id @default(cuid())
  leadId            String
  lead              Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityType      LeadActivityType
  channel           LeadChannel?
  actorUserId       String?
  actor             User?             @relation("LeadActivityActor", fields: [actorUserId], references: [id])
  actorRole         String?
  occurredAt        DateTime
  summary           String?
  outcome           String?
  nextAction        String?
  nextActionDueAt   DateTime?
  metadata          Json?
  relatedEntityType String?
  relatedEntityId   String?
  auditRef          String?
  createdAt         DateTime          @default(now())
  callRecords       CallDisposition[]

  @@index([leadId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([activityType])
}

model LeadStatusHistory {
  id            String         @id @default(cuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus    LeadStatus?
  toStatus      LeadStatus
  event         LeadEvent
  guardsPassed  Json?
  actorUserId   String?
  actor         User?          @relation("LeadStatusHistoryActor", fields: [actorUserId], references: [id])
  actorRole     String?
  reason        String?
  occurredAt    DateTime
  outboxEventId String?
  outboxEvent   LeadOutboxEvent? @relation(fields: [outboxEventId], references: [id])
  auditRef      String?

  @@index([leadId, occurredAt])
  @@index([actorUserId])
  @@index([toStatus, occurredAt])
}

model LeadScore {
  id                String       @id @default(cuid())
  leadId            String
  lead              Lead         @relation("LeadScoreHistory", fields: [leadId], references: [id], onDelete: Cascade)
  score             Int
  tier              LeadTier
  breakdown         Json
  configKey         String
  configVersion     Int
  triggerReason     ScoreTrigger
  computedByUserId  String?
  computedBy        User?        @relation("LeadScoreComputedBy", fields: [computedByUserId], references: [id])
  computedAt        DateTime
  notes             String?
  latestForLead     Lead?        @relation("LeadLatestScore")

  @@index([leadId, computedAt])
  @@index([configKey, configVersion])
}

model LeadAssignment {
  id               String         @id @default(cuid())
  leadId           String
  lead             Lead           @relation("LeadAssignmentHistory", fields: [leadId], references: [id], onDelete: Cascade)
  assigneeUserId   String
  assignee         User           @relation("LeadAssignmentAssignee", fields: [assigneeUserId], references: [id])
  assignedByUserId String?
  assignedBy       User?          @relation("LeadAssignmentAssigner", fields: [assignedByUserId], references: [id])
  assignmentType   AssignmentType
  reason           String?
  startedAt        DateTime
  endedAt          DateTime?
  endReason        String?
  siteId           String
  site             Site           @relation(fields: [siteId], references: [id])
  metadata         Json?
  activeForLead    Lead?          @relation("LeadActiveAssignment")

  @@index([leadId, startedAt])
  @@index([assigneeUserId, startedAt])
}

model LeadFollowUp {
  id                 String           @id @default(cuid())
  leadId             String
  lead               Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerUserId        String
  owner              User             @relation("LeadFollowUpOwner", fields: [ownerUserId], references: [id])
  type               FollowUpType
  priority           FollowUpPriority
  reason             String?
  dueAt              DateTime
  status             FollowUpStatus
  completedAt        DateTime?
  completedByUserId  String?
  completedBy        User?            @relation("LeadFollowUpCompletedBy", fields: [completedByUserId], references: [id])
  outcome            String?
  nextFollowUpId     String?
  nextFollowUp       LeadFollowUp?    @relation("FollowUpChain", fields: [nextFollowUpId], references: [id])
  previousInChain    LeadFollowUp[]   @relation("FollowUpChain")
  rescheduledFromId  String?
  rescheduledFrom    LeadFollowUp?    @relation("FollowUpReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo      LeadFollowUp[]   @relation("FollowUpReschedule")
  cancelReason       String?
  slaScheduleId      String?
  slaSchedule        SlaSchedule?     @relation(fields: [slaScheduleId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  callRecords        CallDisposition[]

  @@index([leadId, createdAt])
  @@index([status, dueAt])
  @@index([ownerUserId, dueAt])
}

model CounsellingSession {
  id               String             @id @default(cuid())
  bookingId        String
  booking          CounsellingBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellorUserId String
  counsellor       User               @relation("CounsellingSessionCounsellor", fields: [counsellorUserId], references: [id])
  startedAt        DateTime?
  endedAt          DateTime?
  attendanceStatus SessionAttendance
  notes            String?
  recordedByUserId String
  recordedBy       User               @relation("CounsellingSessionRecorder", fields: [recordedByUserId], references: [id])
  recordedAt       DateTime
  outcome          CounsellingOutcome?

  @@index([bookingId])
  @@index([leadId, recordedAt])
  @@index([counsellorUserId, recordedAt])
}

model CounsellingOutcome {
  id                   String                     @id @default(cuid())
  sessionId            String                     @unique
  session              CounsellingSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  leadId               String
  lead                 Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recommendation       CounsellingRecommendation
  recommendedByUserId  String
  recommendedBy        User                       @relation("CounsellingOutcomeRecommender", fields: [recommendedByUserId], references: [id])
  rationale            String?
  nextActionType       String?
  nextActionAt         DateTime?
  createdAt            DateTime                   @default(now())

  @@index([leadId, createdAt])
  @@index([recommendation])
}

model Campaign {
  id                  String         @id @default(cuid())
  name                String
  code                String         @unique
  source              LeadSource
  medium              String?
  channel             String?
  startAt             DateTime
  endAt               DateTime?
  budgetInr           Decimal?       @db.Decimal(12, 2)
  actualSpendInr      Decimal?       @db.Decimal(12, 2)
  ownerUserId         String
  owner               User           @relation("CampaignOwner", fields: [ownerUserId], references: [id])
  creativeRefs        Json?
  landingPageUrls     Json?
  referralPartnerId   String?
  utmDefaults         Json?
  status              CampaignStatus
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  leads               Lead[]
  firstTouchAttributions LeadAttribution[] @relation("AttrFirstCampaign")
  lastTouchAttributions  LeadAttribution[] @relation("AttrLastCampaign")
  attributionHistory  LeadAttributionHistory[]

  @@index([status, startAt, endAt])
}

model LeadAttribution {
  id                         String     @id @default(cuid())
  leadId                     String     @unique
  lead                       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  firstTouchAt               DateTime
  firstTouchSource           LeadSource
  firstTouchCampaignId       String?
  firstTouchCampaign         Campaign?  @relation("AttrFirstCampaign", fields: [firstTouchCampaignId], references: [id])
  firstTouchMedium           String?
  firstTouchChannel          String?
  firstTouchCreativeRef      String?
  firstTouchLandingUrl       String?
  firstTouchReferralPartnerId String?
  firstTouchUtm              Json?
  lastTouchAt                DateTime
  lastTouchSource            LeadSource
  lastTouchCampaignId        String?
  lastTouchCampaign          Campaign?  @relation("AttrLastCampaign", fields: [lastTouchCampaignId], references: [id])
  lastTouchMedium            String?
  lastTouchChannel           String?
  lastTouchCreativeRef       String?
  lastTouchLandingUrl        String?
  lastTouchReferralPartnerId String?
  lastTouchUtm               Json?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  @@index([firstTouchCampaignId, createdAt])
  @@index([lastTouchCampaignId, updatedAt])
}

model LeadAttributionHistory {
  id                 String     @id @default(cuid())
  leadId             String
  lead               Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  touchAt            DateTime
  source             LeadSource
  campaignId         String?
  campaign           Campaign?  @relation(fields: [campaignId], references: [id])
  medium             String?
  channel            String?
  creativeRef        String?
  landingUrl         String?
  referralPartnerId  String?
  utm                Json?
  touchType          TouchType
  capturedAt         DateTime

  @@index([leadId, touchAt])
  @@index([campaignId, touchAt])
}

model DuplicateCase {
  id               String           @id @default(cuid())
  leftLeadId       String
  leftLead         Lead             @relation("DuplicateCaseLeft", fields: [leftLeadId], references: [id], onDelete: Cascade)
  rightLeadId      String
  rightLead        Lead             @relation("DuplicateCaseRight", fields: [rightLeadId], references: [id], onDelete: Cascade)
  matchLevel       MatchLevel
  matchSignals     Json
  matchScore       Int
  detectedAt       DateTime
  reviewStatus     DupReviewStatus
  reviewedByUserId String?
  reviewedBy       User?            @relation("DuplicateCaseReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  reviewNotes      String?
  mergeId          String?          @unique
  resultingMerge   LeadMerge?       @relation("DupCaseToMerge", fields: [mergeId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  initiatedMerges  LeadMerge[]      @relation("MergeBackToCase")

  @@index([reviewStatus, matchLevel, detectedAt])
  @@index([leftLeadId])
  @@index([rightLeadId])
}

model LeadMerge {
  id                    String            @id @default(cuid())
  duplicateCaseId       String?
  fromCase              DuplicateCase?    @relation("MergeBackToCase", fields: [duplicateCaseId], references: [id])
  winnerLeadId          String
  winner                Lead              @relation("LeadMergeWinner", fields: [winnerLeadId], references: [id], onDelete: Cascade)
  loserLeadId           String            @unique
  loser                 Lead              @relation("LeadMergeLoser", fields: [loserLeadId], references: [id], onDelete: Cascade)
  decidedByUserId       String
  decidedBy             User              @relation("LeadMergeDecidedBy", fields: [decidedByUserId], references: [id])
  reason                String
  activityCopyStrategy  MergeCopyStrategy
  activitiesCopiedCount Int
  mergedAt              DateTime
  auditRef              String?
  resolvingCases        DuplicateCase[]   @relation("DupCaseToMerge")
}

model LeadConversion {
  id                   String           @id @default(cuid())
  leadId               String           @unique
  lead                 Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  targetType           ConversionTarget
  targetEntityId       String
  decidedByUserId      String
  decidedBy            User             @relation("LeadConversionDecidedBy", fields: [decidedByUserId], references: [id])
  eligibilitySnapshot  Json
  outboxEventId        String?
  outboxEvent          LeadOutboxEvent? @relation(fields: [outboxEventId], references: [id])
  occurredAt           DateTime
  notes                String?
}

model LeadConfig {
  id                String    @id @default(cuid())
  key               String
  version           Int
  payload           Json
  payloadSchemaRef  String
  ownerRole         UserRole
  createdByUserId   String
  createdBy         User      @relation("LeadConfigAuthor", fields: [createdByUserId], references: [id])
  createdAt         DateTime  @default(now())
  approvedByUserId  String?
  approvedBy        User?     @relation("LeadConfigApprover", fields: [approvedByUserId], references: [id])
  approvedAt        DateTime?
  effectiveFrom     DateTime?
  effectiveUntil    DateTime?
  isActive          Boolean   @default(false)
  notes             String?

  @@unique([key, version])
  @@index([key, effectiveFrom])
}

model LeadOutboxEvent {
  id                 String         @id @default(cuid())
  aggregateType      String
  aggregateId        String
  eventType          LeadEventType
  eventVersion       Int
  payload            Json
  occurredAt         DateTime
  enqueuedAt         DateTime       @default(now())
  publishedAt        DateTime?
  dispatchStatus     DispatchStatus @default(PENDING)
  attemptCount       Int            @default(0)
  lastAttemptAt      DateTime?
  lastAttemptError   String?
  lockedUntil        DateTime?
  lockedByWorkerId   String?
  statusHistoryRows  LeadStatusHistory[]
  conversions        LeadConversion[]
  crmJobs            CrmSyncQueue[]
  dlqRows            LeadOutboxDlq[]

  @@index([dispatchStatus, enqueuedAt])
  @@index([aggregateId, occurredAt])
}

model LeadOutboxDlq {
  id                 String         @id @default(cuid())
  originalEventId    String
  originalEvent      LeadOutboxEvent @relation(fields: [originalEventId], references: [id], onDelete: Cascade)
  aggregateType      String
  aggregateId        String
  eventType          String
  payload            Json
  failureReason      String
  attempts           Int
  movedAt            DateTime
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolvedBy         User?          @relation("OutboxDlqResolver", fields: [resolvedByUserId], references: [id])
  resolutionAction   DlqResolution?
}

model NotificationTemplate {
  id               String                 @id @default(cuid())
  key              String
  channel          NotificationChannel
  provider         NotificationProvider
  subject          String?
  body             String
  variables        Json
  language         LeadLanguage
  version          Int
  isActive         Boolean                @default(false)
  approvedByUserId String?
  approvedBy       User?                  @relation("NotificationTemplateApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deliveries       NotificationDeliveryLog[]

  @@unique([key, channel, language, version])
  @@index([channel, isActive])
}

model NotificationDeliveryLog {
  id                 String                 @id @default(cuid())
  leadId             String?
  lead               Lead?                  @relation(fields: [leadId], references: [id])
  templateId         String
  template           NotificationTemplate   @relation(fields: [templateId], references: [id])
  channel            NotificationChannel
  provider           NotificationProvider
  recipient          String
  sentAt             DateTime
  providerMessageId  String?
  deliveryStatus     DeliveryStatus
  statusUpdatedAt    DateTime?
  failureReason      String?
  dncCheckedAt       DateTime
  dncPassed          Boolean
  payloadHash        String?

  @@index([leadId, sentAt])
  @@index([deliveryStatus, sentAt])
  @@index([provider, sentAt])
  @@index([recipient, sentAt])
}

// ===== REPORTS MODULE (v1 · additive-only · read-only across platform) =====

enum ReportCategory {
  CLINICAL
  FINANCE
  LOGISTICS
  COMPLIANCE
  REGULATORY
  OPERATIONAL
}

enum ReportCadence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM
  ON_DEMAND
}

enum ReportExportFormat {
  CSV
  XLSX
  PDF
  JSON
}

enum ReportDeliveryChannel {
  EMAIL
  WHATSAPP
  DOWNLOAD_LINK
}

enum ReportTriggeredBy {
  MANUAL
  SCHEDULED
  API
}

model ReportSchedule {
  id                   String                @id @default(cuid())
  reportId             String
  cadence              ReportCadence
  filterValues         Json
  exportFormat         ReportExportFormat
  subscriberUserIds    String[]
  deliveryChannel      ReportDeliveryChannel @default(EMAIL)
  isActive             Boolean               @default(true)
  createdByUserId      String
  createdBy            User                  @relation("ReportScheduleCreator", fields: [createdByUserId], references: [id])
  nextRunAt            DateTime?
  lastRunAt            DateTime?
  /// Frequency detail: IST hour/minute, day of week/month, quarter month, cron.
  scheduleDetail       Json?
  dataWindowPreset     String?
  dataWindowCustomFrom DateTime?
  dataWindowCustomTo   DateTime?
  comparePreset        String?
  compareCustomFrom    DateTime?
  compareCustomTo      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  runs ReportRun[]

  @@index([reportId])
  @@index([nextRunAt, isActive])
  @@index([createdByUserId])
}

model ReportRun {
  id             String              @id @default(cuid())
  reportId       String
  runByUserId    String?
  runBy          User?               @relation("ReportRunActor", fields: [runByUserId], references: [id])
  triggeredBy    ReportTriggeredBy
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  rowCount       Int?
  exportFormat   ReportExportFormat?
  exportUrl      String?
  errorMessage   String?
  filterSnapshot Json
  scheduleId     String?
  schedule       ReportSchedule?     @relation(fields: [scheduleId], references: [id])

  deliveries ReportDeliveryLog[]

  @@index([reportId])
  @@index([startedAt])
  @@index([scheduleId])
}

model ReportDeliveryLog {
  id               String                @id @default(cuid())
  reportRunId      String
  reportRun        ReportRun             @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  subscriberUserId String
  subscriber       User                  @relation(fields: [subscriberUserId], references: [id])
  channel          ReportDeliveryChannel
  attemptedAt      DateTime              @default(now())
  succeeded        Boolean               @default(false)
  errorMessage     String?

  @@index([reportRunId])
  @@index([subscriberUserId])
}

model ReportSnapshot {
  id                String   @id @default(cuid())
  reportId          String
  snapshotName      String
  capturedAt        DateTime @default(now())
  capturedByUserId  String
  capturedBy        User     @relation("ReportSnapshotCapture", fields: [capturedByUserId], references: [id])
  dataUrl           String
  filterSnapshot    Json
  isImmutable       Boolean  @default(true)
  retentionExpiresAt DateTime?
  notes             String?

  @@index([reportId])
  @@index([capturedAt])
}

model ReportFavorite {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId     String
  savedFilters Json?
  displayName  String
  createdAt    DateTime @default(now())

  @@unique([userId, reportId, displayName])
  @@index([userId])
}
