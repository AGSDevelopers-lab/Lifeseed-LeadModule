# Copy to .env / .env.local and fill with Supabase values.
# Never commit real secrets.

# Supabase Auth (required for login / middleware)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma) — pooled URL for runtime, direct for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeseed?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lifeseed?schema=public"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment gateways (stubs in v1 — never commit real secrets)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_secret_xxxxxxxx
PAYU_KEY=payu_merchant_key
PAYU_SALT=payu_merchant_salt

# Cron / scheduled jobs (Embryology outcome nudges)
# Send as header: X-Cron-Secret: <value>
CRON_SECRET=replace_with_long_random_secret
