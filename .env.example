# Copy to .env / .env.local and fill with Supabase values.
# Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma) — pooled URL for runtime, direct for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeseed?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lifeseed?schema=public"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
