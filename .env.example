# Copy to .env / .env.local and fill with Supabase values.
# Never commit real secrets.

# Supabase Auth (required for login / middleware)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma) — pooled URL for runtime, direct for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeseed?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lifeseed?schema=public"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment gateways (stubs in v1 — never commit real secrets)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_secret_xxxxxxxx
PAYU_KEY=payu_merchant_key
PAYU_SALT=payu_merchant_salt

# Cron / scheduled jobs (Embryology outcome nudges)
# Send as header: X-Cron-Secret: <value>
CRON_SECRET=replace_with_long_random_secret

# SeedScore (7-Chakra wellness engine) — all OFF by default
SEEDSCORE_GATE_ENABLED=false
SEEDSCORE_VISIBLE_TO_DONOR=false
SEEDSCORE_VISIBLE_TO_RECIPIENT=false
SEEDSCORE_RECALC_ON_SCHEDULE=false
# Cron for 6-month recalc flags (header: X-Cron-Secret)
SEEDSCORE_CRON_SECRET=replace_with_seedscore_cron_secret

# Lead Management
# on | off  (default off until staging validation; legacy count+1 generator remains)
# off | shadow | on | strict
# Default: shadow outside production, off in production.
LEAD_STATE_MACHINE_ENABLED=
# on | off  (default off in production; default on in non-production)
LEAD_CONVERSION_PORT_ENABLED=
# off | in_app_only | on  (default in_app_only — DNC gate on all channels)
LEAD_NOTIFICATION_PORT_ENABLED=
# B12 per-channel outbound flags — default OFF. Never set to on without Founder cutover auth.
LEAD_SMS_ENABLED=off
LEAD_EMAIL_ENABLED=off
LEAD_WHATSAPP_ENABLED=off
# B13 staged assignment (site + capacity + active eligibility). Default OFF.
LEAD_ASSIGNMENT_V2_ENABLED=off
# B14 DuplicateCase detection + human-review merge. Default OFF.
LEAD_DUPLICATE_ENABLED=off
# B15 Campaign attribution capture. Default OFF. Campaign CRUD and CAC are RBAC-only.
LEAD_ATTRIBUTION_ENABLED=off
# SMS-Magic send URL is UNLOCKED (verify from official docs / account). Leave empty = no network.
# SMS_MAGIC_API_KEY=
# SMS_MAGIC_SENDER_ID=
# SMS_MAGIC_WEBHOOK_SECRET=
# SMS_MAGIC_SEND_URL=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=
# RESEND_WEBHOOK_SECRET=
# off | partial | on
# Default: off in production, partial in non-production.
LEAD_CONFIG_ENABLED=
# Distinct approver for seed SoD (author = LEAD_SYSTEM_USER_ID)
LEAD_CONFIG_APPROVER_USER_ID=
LEADS_CRON_SECRET=change-me-in-prod
# HMAC for internal lead crons (preferred). Header:
#   X-LifeSeed-Cron-Signature: t=<epochSeconds>, v1=<HMAC-SHA256(t+"."+body, secret)>
LEADS_CRON_HMAC_SECRET=
# off | permissive | strict
# Default: permissive in staging/dev, off in production until HMAC is rolled out.
LEAD_HMAC_CRON_ENFORCED=
# WhatsApp Cloud API app secret (X-Hub-Signature-256)
META_APP_SECRET=
# on | off  (default on immediately in every environment)
LEAD_WHATSAPP_SIGNATURE_ENFORCED=on
LEADS_RATE_LIMIT_PER_IP_PER_HOUR=10
LEADS_MAX_QUEUE_PER_TELECALLER=20
LEADS_AUTO_ASSIGN_ENABLED=true
COUNSELLING_DEFAULT_DURATION_MIN=30
CRM_SYNC_ENABLED=false
WHATSAPP_WEBHOOK_SECRET=stub_ok_dev

# Reports Module (Resend email · scheduled exports · cache)
# Empty RESEND_API_KEY = dry-run mode (logs email content to console)
RESEND_API_KEY=
REPORTS_CRON_SECRET=change-me-in-prod
REPORTS_EXPORT_BUCKET=reports-exports
REPORTS_CACHE_TTL_SECONDS=300
REPORTS_MAX_ROWS_PER_PAGE=100
REPORTS_EXPORT_SIGNED_URL_TTL_MINUTES=1440
REPORTS_EMAIL_FROM=LifeSeed Reports <reports@lifeseed.in>
